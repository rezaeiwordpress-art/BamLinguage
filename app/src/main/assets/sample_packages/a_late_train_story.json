  "title": "A Late Train",
  "titleFa": "قطار دیرهنگام",
  "description": "A B1 story about missing a train, not giving up, and finding a better route.",
  "descriptionFa": "داستانی در سطح B1 درباره از دست دادن قطار، تسلیم نشدن و پیدا کردن مسیری بهتر.",
  "level": "B1",
  "topic": "travel",
  "language": "en",
  "translationLanguage": "fa",
  "estimatedMinutes": 5,
  "metadata": {
