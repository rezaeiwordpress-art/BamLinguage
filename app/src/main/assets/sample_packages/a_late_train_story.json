  "speakers": [],
  "sentences": [
    {
      "id": 1,
      "orderIndex": 0,
      "text": "Sara missed her train again.",
      "translationFa": "سارا دوباره از قطارش جا ماند.",
      "speakerId": null
    },
    {
      "id": 2,
      "orderIndex": 1,
      "text": "She was running late and ran out of time at the station.",
      "translationFa": "او دیرش شده بود و در ایستگاه وقت کم آورد.",
      "speakerId": null
    },
    {
      "id": 3,
      "orderIndex": 2,
      "text": "She did not give up and went to ask for a better route.",
      "translationFa": "او ناامید نشد و رفت تا مسیر بهتری بپرسد.",
      "speakerId": null
    },
    {
      "id": 4,
      "orderIndex": 3,
      "text": "Next week, she will take part in a travel workshop to feel better prepared.",
      "translationFa": "هفته آینده او در یک کارگاه سفر شرکت خواهد کرد تا آمادگی بیشتری احساس کند.",
      "speakerId": null
    }
  ],
