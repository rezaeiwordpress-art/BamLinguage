  "sentences": [
    {
      "id": 1,
      "orderIndex": 0,
      "text": "Good morning, Sara. Are you ready for our trip to Bamiyan?",
      "translationFa": "صبح بخیر سارا. برای سفرمان به بامیان آماده‌ای؟",
      "speakerId": "spk_ali",
      "phoneticHint": "ɡʊd ˈmɔːrnɪŋ ˈsɑːrə. ɑːr juː ˈredi fɔːr ˈaʊər trɪp tuː bɑːmiˈjɑːn?",
      "grammarNoteFa": "ساختار «ready for ...» برای بیان آمادگی درباره یک برنامه یا سفر به کار می‌رود."
    },
    {
      "id": 2,
      "orderIndex": 1,
      "text": "Yes, I packed my warm jacket because the mountain air is crisp.",
      "translationFa": "بله، ژاکت گرمم را جمع کردم چون هوای کوهستان خنک و باطراوت است.",
      "speakerId": "spk_sara",
      "phoneticHint": "jes, aɪ pækt maɪ wɔːrm ˈdʒækɪt bɪˈkɔːz ðə ˈmaʊntən er ɪz krɪsp.",
      "grammarNoteFa": "حرف ربط «because» دلیل انجام کار در جمله قبلی را توضیح می‌دهد."
    },
    {
      "id": 3,
      "orderIndex": 2,
      "text": "The blue lakes of Band-e-Amir look peaceful in the early light.",
      "translationFa": "دریاچه‌های آبی بند امیر در نور اول صبح آرامش‌بخش به نظر می‌رسند.",
      "speakerId": "spk_ali",
      "phoneticHint": "ðə bluː leɪks əv bænd e æˈmɪr lʊk ˈpiːsfəl ɪn ðə ˈɜːrli laɪt.",
      "grammarNoteFa": "فعل «look» اینجا فعل ربطی است و پس از آن صفت (peaceful) می‌آید."
    },
    {
      "id": 4,
      "orderIndex": 3,
      "text": "Let us look after our words and set off together.",
      "translationFa": "بیایید مراقب واژه‌هایمان باشیم و با هم حرکت کنیم.",
      "speakerId": "spk_sara",
      "phoneticHint": "let ʌs lʊk ˈæftər ˈaʊər wɜːrdz ænd set ɒf təˈɡeðər.",
      "grammarNoteFa": "دو فعل عبارتی «look after» (مراقبت کردن) و «set off» (رهسپار شدن) در این جمله آمده‌اند."
    }
  ],
